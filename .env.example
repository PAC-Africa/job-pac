# Copy to .env.local and fill in. Never commit .env.local — .gitignore covers
# `.env*`, and this file is the only exception because it holds no values.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# readable by anyone who views source. That is fine for the four below and fatal
# for the two that are not.

# ── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security entirely. Used in exactly one place —
# writing a guest job application, see lib/supabase/admin.ts — and by
# scripts/migrate-cvs.mjs. Must also be set in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://jobs.pac.africa

# ── Captcha on sign-in and sign-up (Cloudflare Turnstile) ────────
# Supabase → Authentication → Attack Protection must be set to Turnstile to
# match, or every attempt fails with "invalid-input-response". Site key comes
# from the Turnstile dashboard; the matching secret goes into Supabase, NOT
# here — Supabase is what verifies the token, so this app never sees the
# secret. Leave the site key blank to disable the widget locally; if captcha
# is enabled in Supabase, sign-in will then be rejected, which is the
# intended signal.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# The matching secret goes in the Supabase dashboard, NOT here — Supabase is
# what verifies the token, so this app never sees the secret.

# ── Cloudflare R2, for the recovered CV archive ─────────────────
# Server-only. Presigns reads; never exposed to the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Apply-flow rate limiting, see lib/rate-limit.ts ─────────────
# Server-only. Keys the HMAC used to pseudonymise an applicant's IP before it
# reaches the database. Without it, checkRateLimit() logs an error and fails
# open — no rate limiting, not a broken build — so set this before relying on
# migration 026's counter in production. Any long random string; there is
# nothing to look up on a provider dashboard, generate one yourself, e.g.
# `openssl rand -hex 32`.
RATE_LIMIT_HASH_SECRET=

# ── Sentry (error tracking) ──────────────────────────────────────
# Public DSN, safe to expose in the browser bundle. Sentry → Settings →
# Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Server-only. Needed for source-map upload at build time. Sentry → Settings
# → Auth Tokens.
SENTRY_AUTH_TOKEN=

# ── Email (Resend), see lib/email.ts ────────────────────────────
# Server-only. From resend.com/api-keys — scope it to "Sending access" only,
# not full account access.
RESEND_API_KEY=
# Must be on a domain verified in Resend (Domains → Add Domain → add the SPF/
# DKIM/DMARC records it gives you at your DNS host). Sending from an
# unverified domain silently falls back to Resend's sandbox, which only
# delivers to the account owner's own inbox — fine for testing, not for prod.
EMAIL_FROM="PAC Africa Jobs <notifications@pac.africa>"

# ── Cron auth, see app/api/cron/job-alerts/route.ts ─────────────
# Server-only. Any random secret string — set it here and in Vercel; Vercel
# sends it back as `Authorization: Bearer $CRON_SECRET` on every scheduled
# cron request automatically, which is what the route checks against.
CRON_SECRET=
